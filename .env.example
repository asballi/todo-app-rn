# Supabase senkronizasyonu (v4). Bu dosyayı .env olarak kopyalayıp doldur;
# .env depoya girmez. Değerler Supabase panelinde: Project Settings → API.
# Boş bırakılırsa uygulama yalnızca yerel çalışır.
EXPO_PUBLIC_SUPABASE_URL=https://<proje-kimliği>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable (anon) anahtar>
